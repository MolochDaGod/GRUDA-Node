#ifndef GRUDA_CONFIG_SECRETS_H
#define GRUDA_CONFIG_SECRETS_H

/**
 * Device Secrets — Copy this to config_secrets.h and fill in real values.
 * config_secrets.h is gitignored and will not be committed.
 *
 * Architecture: WALLETLESS
 * - No private keys on device
 * - User identity = Web3Auth session via Grudge Account
 * - All signing is server-routed through api.grudge-studio.com
 */

/* ── WiFi ─────────────────────────────────────────── */
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASS"
#define WIFI_SSID_2 ""
#define WIFI_PASS_2 ""
#define WIFI_SSID_3 ""
#define WIFI_PASS_3 ""

/* ── Discord Webhook ────────────────────────────── */
#define DISCORD_WEBHOOK_HOST "discord.com"
#define DISCORD_WEBHOOK_PATH "/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

/* ── Dev Mode (1 = skip Web3Auth, 0 = production) ─── */
#define DEV_MODE 0

/* ── Backend / Master Node Routing ──────────────── */
/* Override these to point the device at a specific master node stack. */
#define API_HOST "api.grudge-studio.com"
#define API_PORT 443
#define WS_HOST "ws.grudge-studio.com"
#define WS_PORT 443
#define ID_HOST "id.grudge-studio.com"

#endif /* GRUDA_CONFIG_SECRETS_H */
